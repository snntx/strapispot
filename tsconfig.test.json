{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": [
    "admin/src/utils/shortcut.ts",
    "admin/src/utils/rank.ts",
    "admin/src/utils/highlight.ts",
    "admin/src/utils/command.ts",
    "admin/src/utils/relations.ts",
    "server/src/settings.ts",
    "tests/**/*.ts"
  ]
}
